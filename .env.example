# Inngest Configuration
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
INNGEST_APP_ID=anr-laundry-billing
INNGEST_DEV_SERVER_URL=http://localhost:8288

# Google Gemini Vision OCR
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Zoho Books API Credentials
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORG_ID=your_zoho_org_id
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_API_URL=https://www.zohoapis.com/books/v3

# Google Workspace (Drive & Sheets)
CONTROL_SHEETS_FOLDER_ID=your_google_drive_folder_id
# Provide either base64 encoded service account json OR file path:
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Notification and System Settings
NOTIFICATION_EMAIL=cdanso@service4gh.com
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Mock / Dry-Run Mode (Set to true to run end-to-end tests or demos without live credentials)
MOCK_MODE=false
